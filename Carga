<link rel="apple-touch-icon" href="data:image/png;base64,">
<title>Supervielle — Agregar familia / Envío de dinero</title>
<style>
  :root {
    --maroon: #8A001B;
    --ink: #14161A;
    --muted: #8A8F94;
  }
  * { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
  html, body {
    height: 100%;
    margin: 0;
    background: #DADADA;
    font-family: -apple-system, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  }
  body {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100%;
    padding: 0;
  }

  .screen {
    position: relative;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 440 / 956;
    background: linear-gradient(to bottom, #ffffff 0%, #FAFAFA 100%);
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(0,0,0,0.04);
  }
  @media (min-width: 480px) {
    .screen { height: 92vh; max-height: 956px; width: auto; }
  }

  .brand-logo {
    position: absolute;
    top: 24px;
    left: 50%;
    transform: translateX(-50%);
    width: 34%;
    aspect-ratio: 203 / 27;
    z-index: 10;
  }
  .brand-logo img { width: 100%; height: 100%; display: block; }

  .arc {
    position: absolute;
    border-radius: 50%;
    border: 1px solid transparent;
    pointer-events: none;
  }
  .arc-tl {
    width: 28.7%; aspect-ratio: 1/1;
    left: -2.27%; top: -8.62%;
    border-image: linear-gradient(to bottom, #F2F2F7, var(--maroon)) 1;
  }
  .arc-br {
    width: 28.7%; aspect-ratio: 1/1;
    right: -2.27%; bottom: -8.62%;
    border-image: linear-gradient(to bottom, #F2F2F7, var(--maroon)) 1;
  }

  .content-box {
    position: absolute;
    left: 9.09%;
    top: 26.26%;
    width: 82.05%;
    height: 29.92%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .viewport {
    position: relative;
    height: 100%;
    aspect-ratio: 1 / 1;
    max-width: 100%;
  }
  .scene {
    position: absolute;
    inset: 0;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .scene.active { display: flex; }
  .scene-inner {
    position: relative;
    width: 100%;
    height: 100%;
    background: transparent;
    overflow: hidden;
    transform: scale(0.4);
    opacity: 0;
  }
  .scene-inner.bounce-in { animation: sceneBounceIn 0.6s cubic-bezier(.34,1.56,.64,1) forwards; }
  .scene-inner.bounce-out { animation: sceneBounceOut 0.5s cubic-bezier(.5,-0.2,.7,.3) forwards; }
  @keyframes sceneBounceIn {
    0%   { opacity: 0; transform: scale(0.4); }
    55%  { opacity: 1; transform: scale(1.08); }
    75%  { transform: scale(0.95); }
    100% { opacity: 1; transform: scale(1); }
  }
  @keyframes sceneBounceOut {
    0%   { opacity: 1; transform: scale(1); }
    30%  { transform: scale(1.1); }
    100% { opacity: 0; transform: scale(0.35); }
  }

  /* Scene 1: agregar familia */
  .slot {
    position: absolute;
    width: 27%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.35);
    transition: opacity 0.38s cubic-bezier(.2,.9,.3,1.2), transform 0.46s cubic-bezier(.2,.9,.3,1.4);
  }
  .slot.show { opacity: 1; transform: scale(1); }
  .slot canvas { width: 100%; height: 100%; display: block; border-radius: 50%; }
  .slot[data-pos="tl"] { top: 15%;  left: 15%; }
  .slot[data-pos="tm"] { top: 9%;  left: 36.5%; }
  .slot[data-pos="tr"] { top: 15%;  right: 15%; }
  .slot[data-pos="bl"] { bottom: 15%; left: 15%; }
  .slot[data-pos="bm"] { bottom: 9%; left: 36.5%; }
  .slot[data-pos="br"] { bottom: 15%; right: 15%; }
  .plus-btn {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 22%;
    aspect-ratio: 67 / 76;
    transform: translate(-50%, -50%) scale(0.3);
    opacity: 0;
    z-index: 5;
  }
  .plus-btn.enter { animation: btnBounceIn 0.6s cubic-bezier(.34,1.56,.64,1) forwards; }
  @keyframes btnBounceIn {
    0%   { opacity: 0; transform: translate(-50%, -50%) scale(0.3); }
    55%  { opacity: 1; transform: translate(-50%, -50%) scale(1.18); }
    75%  { transform: translate(-50%, -50%) scale(0.92); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  }
  .plus-btn img { width: 100%; height: 100%; display: block; transition: transform 0.14s ease; }
  .plus-btn.pressed img { transform: scale(0.86); }

  .ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: #1AB065;
    transform: translate(-50%, -50%) scale(1);
    opacity: 0;
    pointer-events: none;
    z-index: 4;
  }
  .ripple.animate {
    animation: rippleWave 1.1s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .ripple.delay {
    animation-delay: 0.18s;
  }
  @keyframes rippleWave {
    0%   { opacity: 0.2; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(3.2); }
  }
  .nino-ripple {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 55%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: #1AB065;
    transform: translate(-50%, -50%) scale(1);
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }
  .nino-ripple.animate {
    animation: ninoRippleWave 0.95s cubic-bezier(.2,.7,.3,1) forwards;
  }
  .nino-ripple.delay { animation-delay: 0.15s; }
  @keyframes ninoRippleWave {
    0%   { opacity: 0.22; transform: translate(-50%, -50%) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -50%) scale(2.1); }
  }

  /* Scene 2: envío de dinero */
  .avatar {
    position: absolute;
    top: 50%;
    width: 30%;
    aspect-ratio: 1 / 1;
    transform: translate(-50%, -50%);
  }
  .avatar canvas { width: 100%; height: 100%; display: block; border-radius: 50%; }
  #adultaSlot { left: 20%; }
  #ninoSlot   { left: 80%; }
  .money {
    position: absolute;
    top: 50%;
    left: 30%;
    width: 24%;
    aspect-ratio: 3 / 2;
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0;
    pointer-events: none;
    z-index: 4;
  }
  .money canvas { width: 100%; height: 100%; display: block; }

  .headline {
    position: absolute;
    left: 9.09%;
    top: 55%;
    width: 82%;
    text-align: center;
  }
  .headline span {
    display: block;
    font-size: clamp(16px, 4.8vw, 22px);
    font-weight: 800;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.2;
    opacity: 0;
    transition: opacity 0.5s cubic-bezier(.5,-0.2,.7,.3);
  }
  .headline span.show { opacity: 1; }
</style>
</head>
<body>

  <div class="screen">
    <div class="brand-logo"><img src="data:image/svg+xml;base64," alt="Superfamilia"></div>
    
    <div class="content-box">
      <div class="viewport">
        <div class="scene" id="scene1">
          <div class="scene-inner" id="scene1Inner">
            <div class="slot" data-pos="tl" data-key="nina"><canvas width="280" height="280"></canvas></div>
            <div class="slot" data-pos="tm" data-key="adulto"><canvas width="280" height="280"></canvas></div>
            <div class="slot" data-pos="tr" data-key="nino"><canvas width="280" height="280"></canvas></div>
            <div class="slot" data-pos="bl" data-key="abuela"><canvas width="280" height="280"></canvas></div>
            <div class="slot" data-pos="bm" data-key="adulta"><canvas width="280" height="280"></canvas></div>
            <div class="slot" data-pos="br" data-key="abuelo"><canvas width="280" height="280"></canvas></div>
            <div class="plus-btn" id="plusBtn">
              <div class="ripple" id="ripple1"></div>
              <div class="ripple delay" id="ripple2"></div>
              <img src="data:image/png;base64," alt=""></div>
          </div>
        </div>

        <div class="scene" id="scene2">
          <div class="scene-inner" id="scene2Inner">
            <div class="avatar" id="adultaSlot"><canvas width="280" height="280"></canvas></div>
            <div class="avatar" id="ninoSlot">
              <div class="nino-ripple" id="ninoRipple1"></div>
              <div class="nino-ripple delay" id="ninoRipple2"></div>
              <canvas width="280" height="280"></canvas>
            </div>
            <div class="money" id="moneyEl"><canvas width="240" height="160"></canvas></div>
          </div>
        </div>
      </div>
    </div>

    <div class="headline">
      <span id="headlineText1">Agregá a tus familiares</span>
      <span id="headlineText2" style="position:absolute; top:-14px; left:0; right:0;">Enviá dinero a tus familiares al instante</span>
    </div>
  </div>

<script>
  const FAMILIA_VIDEOS = {"nina": "data:video/mp4;base64,", "adulto": "data:video/mp4;base64,", "nino": "data:video/mp4;base64,", "abuela": "data:video/mp4;base64,", "abuelo": "data:video/mp4;base64,", "adulta": "data:video/mp4;base64,"};
  const ENVIO_VIDEOS = {"adulta": "data:video/mp4;base64,", "nino": "data:video/mp4;base64,", "money": "data:video/mp4;base64,"};

  function setupPlayer(canvas, src, lazy) {
    const ctx = canvas.getContext('2d');
    const video = document.createElement('video');
    if (!lazy) video.src = src;
    video.muted = true;
    video.loop = true;
    video.playsInline = true;
    video.preload = lazy ? 'none' : 'auto';
    video.style.display = 'none';
    document.body.appendChild(video);

    const work = document.createElement('canvas');
    const workCtx = work.getContext('2d', { willReadFrequently: true });
    const p = { video, canvas, ctx, work, workCtx, running: false, raf: null, _src: src, _loaded: !lazy };

    p.warm = function warm() {
      if (p._loaded) return;
      p._loaded = true;
      video.preload = 'auto';
      video.src = p._src;
      video.load();
    };

    p.composite = function composite() {
      if (video.videoWidth === 0) { p.raf = requestAnimationFrame(composite); return; }
      const halfW = video.videoWidth / 2;
      const h = video.videoHeight;
      if (work.width !== halfW || work.height !== h) { work.width = halfW; work.height = h; }
      workCtx.drawImage(video, 0, 0, halfW, h, 0, 0, halfW, h);
      const rgbData = workCtx.getImageData(0, 0, halfW, h);
      workCtx.drawImage(video, halfW, 0, halfW, h, 0, 0, halfW, h);
      const alphaData = workCtx.getImageData(0, 0, halfW, h);
      const out = ctx.createImageData(halfW, h);
      for (let i = 0; i < rgbData.data.length; i += 4) {
        out.data[i] = rgbData.data[i];
        out.data[i+1] = rgbData.data[i+1];
        out.data[i+2] = rgbData.data[i+2];
        out.data[i+3] = alphaData.data[i];
      }
      if (canvas.width !== halfW || canvas.height !== h) { canvas.width = halfW; canvas.height = h; }
      ctx.putImageData(out, 0, 0);
      p.raf = requestAnimationFrame(composite);
    };
    p.start = function start() {
      if (p.running) return;
      p.warm();
      p.running = true;
      video.currentTime = 0;
      video.play().catch(() => {});
      p.composite();
    };
    p.stop = function stop() {
      p.running = false;
      if (p.raf) cancelAnimationFrame(p.raf);
      video.pause();
      video.currentTime = 0;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    };
    return p;
  }

  // ---------- Scene 1 ----------
  const familiaPlayers = {};
  document.querySelectorAll('#scene1 .slot').forEach(slot => {
    const key = slot.dataset.key;
    familiaPlayers[key] = setupPlayer(slot.querySelector('canvas'), FAMILIA_VIDEOS[key]);
  });
  const plusBtn = document.getElementById('plusBtn');
  const FAMILIA_SEQUENCE = ["nina", "adulto", "nino", "abuela", "adulta", "abuelo"];
  const STAGGER_MS = 250;

  function runScene1(onDone) {
    // prep scene 2's videos in the background while this scene plays, so they're ready by the time they're needed
    adultaPlayer.warm();
    ninoPlayer.warm();
    moneyPlayer.warm();

    document.querySelectorAll('#scene1 .slot').forEach(s => s.classList.remove('show'));
    plusBtn.classList.remove('enter');
    plusBtn.style.opacity = '0';
    plusBtn.style.transform = 'translate(-50%, -50%) scale(0.3)';
    document.getElementById('ripple1').classList.remove('animate');
    document.getElementById('ripple2').classList.remove('animate');

    setTimeout(() => {
      plusBtn.classList.add('enter');
      setTimeout(() => {
        plusBtn.classList.add('pressed');
        setTimeout(() => plusBtn.classList.remove('pressed'), 160);
        const ripple1 = document.getElementById('ripple1');
        const ripple2 = document.getElementById('ripple2');
        [ripple1, ripple2].forEach(r => {
          r.classList.remove('animate');
          void r.offsetWidth;
          r.classList.add('animate');
        });
        FAMILIA_SEQUENCE.forEach((key, i) => {
          setTimeout(() => {
            const slot = document.querySelector(`#scene1 .slot[data-key="${key}"]`);
            slot.classList.add('show');
            familiaPlayers[key].start();
          }, i * STAGGER_MS);
        });
        const totalReveal = FAMILIA_SEQUENCE.length * STAGGER_MS;
        setTimeout(onDone, totalReveal + 2200);
      }, 620);
    }, 300);
  }
  function stopScene1() { Object.values(familiaPlayers).forEach(p => p.stop()); }

  // ---------- Scene 2 ----------
  const adultaPlayer = setupPlayer(document.querySelector('#adultaSlot canvas'), ENVIO_VIDEOS.adulta, true);
  const ninoPlayer   = setupPlayer(document.querySelector('#ninoSlot canvas'), ENVIO_VIDEOS.nino, true);
  const moneyPlayer  = setupPlayer(document.querySelector('#moneyEl canvas'), ENVIO_VIDEOS.money, true);
  const moneyEl = document.getElementById('moneyEl');

  const NINO_DURATION_MS = 4042;
  const MONEY_ARRIVAL_MS = 2000;
  const MONEY_TRAVEL_MS = 1500;
  const MONEY_START_DELAY_MS = MONEY_ARRIVAL_MS - MONEY_TRAVEL_MS;
  const RIPPLE_TOTAL_MS = 1100; // ripple duration (950ms) + its 150ms stagger delay
  const HEADLINE_FADE_MS = 600; // matches the .headline span opacity transition
  const SCENE2_END_BUFFER_MS = 200;

  let scene2Timeouts = [];

  function flyMoney() {
    moneyPlayer.start();
    moneyEl.style.transition = 'none';
    moneyEl.style.left = '30%';
    moneyEl.style.top = '54%';
    moneyEl.style.opacity = '0';
    moneyEl.style.transform = 'translate(-50%, -50%) scale(0.55) rotate(-6deg)';
    void moneyEl.offsetWidth;

    const PHASE1_MS = Math.round(MONEY_TRAVEL_MS * 0.72);
    const PHASE2_MS = MONEY_TRAVEL_MS - PHASE1_MS;

    moneyEl.style.transition = `left ${PHASE1_MS}ms cubic-bezier(.3,.1,.3,1), top ${PHASE1_MS}ms ease-in-out, opacity 250ms ease, transform ${PHASE1_MS}ms ease-in-out`;
    moneyEl.style.opacity = '1';
    moneyEl.style.left = '68%';
    moneyEl.style.top = '47%';
    moneyEl.style.transform = 'translate(-50%, -50%) scale(1) rotate(4deg)';

    const t1 = setTimeout(() => {
      moneyEl.style.transition = `left ${PHASE2_MS}ms ease-in, top ${PHASE2_MS}ms ease-in, transform ${PHASE2_MS}ms ease-in`;
      moneyEl.style.left = '80%';
      moneyEl.style.top = '46%';
      moneyEl.style.transform = 'translate(-50%, -50%) scale(0) rotate(10deg)';
    }, PHASE1_MS);

    const t2 = setTimeout(() => { moneyPlayer.stop(); }, MONEY_TRAVEL_MS + 80);
    scene2Timeouts.push(t1, t2);
  }

  function triggerNinoRipples() {
    const r1 = document.getElementById('ninoRipple1');
    const r2 = document.getElementById('ninoRipple2');
    [r1, r2].forEach(r => {
      r.classList.remove('animate');
      void r.offsetWidth;
      r.classList.add('animate');
    });
  }

  function runScene2(onDone) {
    adultaPlayer.start();
    ninoPlayer.start();

    // single flight only — no repeats
    const t0 = setTimeout(flyMoney, MONEY_START_DELAY_MS);
    scene2Timeouts.push(t0);

    const arrivalMs = MONEY_START_DELAY_MS + MONEY_TRAVEL_MS;

    // ripples behind the niño exactly when the bill lands
    const tRipple = setTimeout(triggerNinoRipples, arrivalMs);
    scene2Timeouts.push(tRipple);

    // both motions (bill landing + ripples) are fully done at this point
    const motionCompleteMs = arrivalMs + RIPPLE_TOTAL_MS;

    // finish the scene once the motion is done — headline fade-out happens
    // in the orchestrator, timed to start together with the bounce-out
    setTimeout(onDone, motionCompleteMs);
  }
  function stopScene2() {
    adultaPlayer.stop();
    ninoPlayer.stop();
    moneyPlayer.stop();
    moneyEl.style.transition = 'none';
    moneyEl.style.opacity = '0';
    scene2Timeouts.forEach(clearTimeout);
    scene2Timeouts = [];
    document.getElementById('ninoRipple1').classList.remove('animate');
    document.getElementById('ninoRipple2').classList.remove('animate');
  }

  // ---------- Headline swap ----------
  const h1 = document.getElementById('headlineText1');
  const h2 = document.getElementById('headlineText2');
  function showHeadline(n) {
    if (n === 1) { h1.classList.add('show'); h2.classList.remove('show'); }
    else { h2.classList.add('show'); h1.classList.remove('show'); }
  }
  function hideHeadline() {
    h1.classList.remove('show');
    h2.classList.remove('show');
  }

  // ---------- Orchestrator (2 scenes, looping) ----------
  const scenes = {
    1: { el: document.getElementById('scene1'), inner: document.getElementById('scene1Inner'), run: runScene1, stop: stopScene1 },
    2: { el: document.getElementById('scene2'), inner: document.getElementById('scene2Inner'), run: runScene2, stop: stopScene2 },
  };
  const ORDER = [1, 2];
  let currentIdx = 0;

  function showScene(n) {
    const s = scenes[n];
    showHeadline(n);
    s.el.classList.add('active');
    s.inner.classList.remove('bounce-out');
    s.inner.classList.add('bounce-in');
  }
  function hideScene(n, cb) {
    const s = scenes[n];
    hideHeadline();
    s.inner.classList.remove('bounce-in');
    s.inner.classList.add('bounce-out');
    setTimeout(() => {
      s.el.classList.remove('active');
      s.stop();
      cb && cb();
    }, 500);
  }
  function step() {
    const n = ORDER[currentIdx];
    showScene(n);
    scenes[n].run(() => {
      hideScene(n, () => {
        currentIdx = (currentIdx + 1) % ORDER.length;
        setTimeout(step, 250);
      });
    });
  }

  setTimeout(step, 400);
</script>
</body>
